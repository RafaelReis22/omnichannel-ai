# =============================================================
# omnichannel-ai — variáveis de ambiente (modelo)
# Copie para .env e preencha. NUNCA commite o .env real.
# =============================================================

# --- Banco de dados (Postgres 16 + pgvector) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/omnichannel
DATABASE_USERNAME=omnichannel
DATABASE_PASSWORD=changeme-local-only

# --- Redis (cache, sessão, rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# --- RabbitMQ (filas: canais, IA, webhooks) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=omnichannel
RABBITMQ_PASSWORD=changeme-local-only

# --- Autenticação (JWT) ---
# Gere com: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- 2FA (TOTP): criptografia do segredo em repouso ---
# Gere com: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# --- Canais: criptografia de credenciais em repouso ---
# Gere com: openssl rand -base64 32
CHANNEL_CREDENTIALS_KEY=

# --- IA (Spring AI) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- WhatsApp (BSP — preencher conforme provedor escolhido) ---
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_WEBHOOK_SECRET=

# --- Meta Graph API (Instagram / Messenger — Fase 2) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- E-mail ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_TRANSACTIONAL_API_KEY=

# --- Object storage (S3-compatível / Cloudflare R2) ---
# MinIO local (docker compose) por padrão; em produção, Cloudflare R2
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=changeme-local-only
S3_BUCKET=omnichannel-media
S3_REGION=auto

# --- IA sem custo em dev (docs/10-teste-sem-custo.md) ---
# Troque para "ollama" nos dois para usar modelo local (sem chave paga)
AI_CHAT_PROVIDER=anthropic
AI_EMBEDDING_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Observabilidade ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Aplicação ---
APP_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev
# origens do dashboard autorizadas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000
